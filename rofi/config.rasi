/**
 * Black, White & Purple Minimalist - Compact Floating Launcher
 * Config for Rofi
 **/

configuration {
    modi:                       "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 10";
    show-icons:                 true;
    icon-theme:                 "breeze-dark";
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

@theme "/dev/null"

* {
    bg-base:        #0d0d12;
    bg-surface:     #171720;
    bg-surface-sel: #252535;

    fg-text:        #ffffff;
    fg-subtext:     #7c7c90;
    fg-purple:      #a855f7;
    fg-violet:      #c084fc;
    fg-red:         #ef4444;

    background-color: transparent;
    text-color:       @fg-text;
    margin:           0px;
    padding:          0px;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            440px;
    border:           2px;
    border-color:     @fg-purple;
    border-radius:    12px;
    background-color: @bg-base;
    cursor:           "default";
    padding:          14px;
}

mainbox {
    enabled:          true;
    spacing:          10px;
    background-color: transparent;
    children:         [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    enabled:          true;
    spacing:          10px;
    padding:          8px 12px;
    border-radius:    8px;
    background-color: @bg-surface;
    text-color:       @fg-text;
    children:         [ "prompt", "entry" ];
}

prompt {
    enabled:          true;
    background-color: transparent;
    text-color:       @fg-purple;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled:          true;
    background-color: transparent;
    text-color:       @fg-text;
    cursor:           text;
    placeholder:      "Search apps...";
    placeholder-color:@fg-subtext;
    font:             "JetBrainsMono Nerd Font 10";
}

listview {
    enabled:          true;
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          4px;
    background-color: transparent;
    cursor:           "default";
}

element {
    enabled:          true;
    spacing:          10px;
    padding:          7px 10px;
    border-radius:    7px;
    background-color: transparent;
    text-color:       @fg-text;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-text;
}

element selected.normal {
    background-color: @bg-surface-sel;
    text-color:       @fg-text;
    border:           1px;
    border-color:     @fg-purple;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             22px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

mode-switcher {
    enabled:          true;
    spacing:          8px;
    background-color: transparent;
}

button {
    padding:          5px 10px;
    border-radius:    6px;
    background-color: @bg-surface;
    text-color:       @fg-subtext;
    cursor:           pointer;
    font:             "JetBrainsMono Nerd Font 9";
}

button selected {
    background-color: @fg-purple;
    text-color:       #ffffff;
}

message {
    background-color: transparent;
    border:           0px;
}

textbox {
    padding:          8px;
    border-radius:    6px;
    background-color: @bg-surface;
    text-color:       @fg-text;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          10px;
    border-radius:    8px;
    background-color: @bg-base;
    text-color:       @fg-red;
}
